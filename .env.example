# Enter the image tag of wordpress you want to use
## ex. 6.8.2-php8.4-apache (apache version) or 6.8.2-php8.4-fpm
WORDPRESS_IMAGE_TAG=enter_wordpress_image_tag

# Port where the wordpress website should run
WORDPRESS_PORT=enter_wordpress_port

# Database configurations
WORDPRESS_DB_NAME=enter_db_name
WORDPRESS_DB_USER=enter_db_user

# Should be false in production environment
# Set WORDPRESS_DEBUG to an empty value or simply omit it to ensure WP_DEBUG is false
WORDPRESS_DEBUG=

# Use WORDPRESS_CONFIG_EXTRA for other specific constants
# Example for setting site URL:
# WORDPRESS_CONFIG_EXTRA="define('WP_HOME', 'https://example.com/blog'); define('WP_SITEURL', 'https://example.com/blog');"
WORDPRESS_CONFIG_EXTRA="define('WP_DEBUG_LOG', false); define('WP_DEBUG_DISPLAY', false); define('SCRIPT_DEBUG', false); define('WP_MEMORY_LIMIT', '512M');"

# # # # # # # # # # # # # # # # #
# SNAPSHOT UTILITY              #
# # # # # # # # # # # # # # # # #
# enter Y to enable snapshot utility
# or leave it empty to disable snapshot utility
ENABLE_SNAPSHOT=
# enter the time between 0-23 to specify the hour when the snapshot tool to run or interval like */4 to set the snapshot schedule every 4 hours
# use comma separator to run the snapshot multiple times (example: 0,12 or */4)
# Leave it empty to only install snapshot utility without periodic cron (manual run only)
SNAPSHOT_TIME=
# Google Cloud Storage Bucket Name
# enter the name of the bucket to store the snapshot
# Leave it empty to save the snapshot to local directory
GCS_BUCKET_NAME=
# Google Drive Upload Configuration
# enter the Google Drive access token (Bearer token) or path to a file containing the token
# Leave it empty if using GDRIVE_SERVICE_ACCOUNT_KEY
GDRIVE_ACCESS_TOKEN=
# enter the path to the Google Drive Service Account JSON key file (e.g. .secrets/gdrive_sa.json)
# If set, snapshot utility will automatically generate and refresh access tokens using this key
GDRIVE_SERVICE_ACCOUNT_KEY=
# enter the Google Drive folder ID to store the snapshot (Optional; supports both My Drive and Shared Drives)
# Leave it empty to save to the root of Google Drive
GDRIVE_FOLDER_ID=
# enter the chunk size in MB for Google Drive resumable upload
# default: 10
GDRIVE_CHUNK_SIZE=10
# enter the maximum number of snapshots to retain on Google Drive (lifecycle retention management)
# older snapshots for this service will be automatically deleted after a successful upload
# default: 7 (leave empty to retain all snapshots indefinitely)
GDRIVE_MAX_BACKUPS=7
# ask to replace the existing snapshot file
# enter "Y" to add question to replace the existing snapshot file
# or leave it empty to replace the existing snapshot file without asking (default; recommended for CI/CD)
ASK_TO_REPLACE_EXISTING_SNAPSHOT=
# enter the custom directories to backup (semicolon separated)
# example: /home/devopsadmin/workground/docker-wordpress/scripts; /home/devopsadmin/workground/docker-wordpress/php-config
SNAPSHOT_CUSTOM_DIRS=
# choose snapshot compression level from 1-19 (zstd command must support it)
# 1-3: Fastest (recommended for very fast backups)
# 4-9: Balanced (recommended for balance between speed and compression)
# 9-19: Best compression (recommended for maximum compression)
# default level: 7
SNAPSHOT_COMPRESSION_LEVEL=7
# Secondary VPS Remote Snapshot (SSH)
# Leave SNAPSHOT_REMOTE_HOST empty to run snapshot locally (Option 1 - default)
# Fill SNAPSHOT_REMOTE_HOST to offload packaging and storage to a Secondary VPS (Option 2)
SNAPSHOT_REMOTE_HOST=
# SSH username on the Secondary VPS (e.g. wpbackup)
SNAPSHOT_REMOTE_USER=
# SSH port on the Secondary VPS (default: 22)
SNAPSHOT_REMOTE_PORT=22
# Optional: Path to private SSH key for Secondary VPS (e.g. ~/.ssh/snapshot-vps1-vps2)
# Generate automatically with: ./scripts/generate-snapshot-ssh-key.sh
SNAPSHOT_REMOTE_KEY=
