#!/usr/bin/env bash
set -e
# Category: Utility
# Description: Creates a zip bundle containing WordPress database dump and wordpress files.
# Usage: ./scripts/backupdata-SERVICE_NAME.sh
# Dependencies: 7z, docker, sudo, git, curl, rsync

CURRENT_DIR=$(dirname "$(readlink -f "$0")")
CURRENT_DIR_USER=$(stat -c '%U' "$CURRENT_DIR")
PATH_TO_WP=$(sudo -u "$CURRENT_DIR_USER" git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel 2>/dev/null || git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel 2>/dev/null || dirname "$CURRENT_DIR")
SERVICE_NAME=$(basename "$PATH_TO_WP")
REPOSITORY_OWNER=$(stat -c '%U' "$PATH_TO_WP" 2>/dev/null || echo "$USER")
OWNER_HOME=$(eval echo "~$REPOSITORY_OWNER" 2>/dev/null || echo "$HOME")
[ -z "$OWNER_HOME" ] && OWNER_HOME="$HOME"

# Source helper libraries if available
if [ -f "$CURRENT_DIR/lib/wp_utils.sh" ]; then
  # shellcheck source=/dev/null
  source "$CURRENT_DIR/lib/wp_utils.sh"
elif [ -f "$PATH_TO_WP/scripts/lib/wp_utils.sh" ]; then
  # shellcheck source=/dev/null
  source "$PATH_TO_WP/scripts/lib/wp_utils.sh"
fi

# --- Logging Functions & Colors ---
COLOR_RESET="\033[0m"
COLOR_INFO="\033[0;34m"
COLOR_SUCCESS="\033[0;32m"
COLOR_WARN="\033[0;33m"
COLOR_ERROR="\033[0;31m"

log() {
  local color="$1"
  local emoji="$2"
  local message="$3"
  echo -e "${color}[$(date +"%Y-%m-%d %H:%M:%S")] ${emoji} ${message}${COLOR_RESET}"
}

log_info() { log "${COLOR_INFO}" "ℹ️" "$1"; }
log_success() { log "${COLOR_SUCCESS}" "✅" "$1"; }
log_warn() { log "${COLOR_WARN}" "⚠️" "$1"; }
log_error() { log "${COLOR_ERROR}" "❌" "$1"; }

# --- Database Operations ---
is_mysql_container_running() {
  local compose_file="$PATH_TO_WP/docker-compose.yml"
  [ ! -f "$compose_file" ] && return 1
  local cid
  cid=$(docker compose -f "$compose_file" ps -q db 2>/dev/null || true)
  if [ -n "$cid" ] && [ "$(docker inspect -f '{{.State.Running}}' "$cid" 2>/dev/null)" = "true" ]; then
    return 0
  fi
  return 1
}

ensure_mysql_container_running() {
  local compose_file="$PATH_TO_WP/docker-compose.yml"
  if ! is_mysql_container_running; then
    log_info "Starting database container 'db'..."
    docker compose -f "$compose_file" up -d db
    log_info "Waiting for MySQL database service to become ready..."
    local attempts=0
    local max_attempts=30
    while [ $attempts -lt $max_attempts ]; do
      if docker compose -f "$compose_file" exec -T db sh -c 'mysqladmin ping -h localhost --silent' 2>/dev/null; then
        log_success "MySQL database is ready."
        return 0
      fi
      sleep 2
      attempts=$((attempts + 1))
    done
    log_error "MySQL database did not become ready in time."
    return 1
  fi
  return 0
}

run_mysql_dump() {
  local db_name="$1"
  local compose_file="$PATH_TO_WP/docker-compose.yml"
  local env_file="$PATH_TO_WP/.env"

  if [ -z "$db_name" ]; then
    db_name=$(grep "^WORDPRESS_DB_NAME=" "$env_file" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  fi

  local db_user
  db_user=$(grep "^WORDPRESS_DB_USER=" "$env_file" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  [ -z "$db_user" ] && db_user="wordpress"

  ensure_mysql_container_running

  docker compose -f "$compose_file" exec -T db sh -c '
    if [ -f /run/secrets/db_password ]; then
      PASS=$(cat /run/secrets/db_password)
    else
      PASS="$MYSQL_PASSWORD"
    fi
    MYSQL_PWD="$PASS" exec mysqldump -u "'"$db_user"'" --single-transaction --quick --routines --triggers "'"$db_name"'"
  '
}

extract_wp_version() {
  local version_file="$PATH_TO_WP/data/wordpress/wp-includes/version.php"
  if [ -f "$version_file" ]; then
    local ver
    ver=$(grep "\$wp_version\s*=" "$version_file" 2>/dev/null | head -n 1 | cut -d "'" -f 2 | tr -d '\r\n')
    if [ -n "$ver" ]; then
      echo "$ver"
      return 0
    fi
  fi
  local env_file="$PATH_TO_WP/.env"
  local img_tag
  img_tag=$(grep "^WORDPRESS_IMAGE_TAG=" "$env_file" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//' || true)
  echo "${img_tag:-unknown}"
}

main() {
  # Self-elevate to root if not already
  if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
    exit 1
  fi

  # Lower I/O and CPU scheduling priority
  if command -v ionice >/dev/null 2>&1; then
    ionice -c2 -n7 -p $$ 2>/dev/null || true
  fi
  renice -n 19 -p $$ >/dev/null 2>&1 || true

  local zip_cmd="7z"
  if ! command -v 7z >/dev/null 2>&1; then
    if command -v 7za >/dev/null 2>&1; then
      zip_cmd="7za"
    else
      log_error "7z command could not be found. Please install with: sudo apt install 7zip || sudo apt install p7zip-full"
      exit 1
    fi
  fi

  local ENV_FILE="$PATH_TO_WP/.env"
  if [ ! -f "$ENV_FILE" ]; then
    log_error ".env file not found at $ENV_FILE"
    exit 1
  fi

  local WORDPRESS_DB_NAME
  WORDPRESS_DB_NAME=$(grep "^WORDPRESS_DB_NAME=" "$ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  if [ -z "$WORDPRESS_DB_NAME" ]; then
    read -rp "Enter the WordPress database name: " WORDPRESS_DB_NAME
  fi

  local WP_TMP_DIR="$OWNER_HOME/.wordpress-tmp/$SERVICE_NAME"
  mkdir -p "$WP_TMP_DIR"
  chmod 700 "$OWNER_HOME/.wordpress-tmp" "$WP_TMP_DIR" 2>/dev/null || true
  chown -R "$REPOSITORY_OWNER":"$REPOSITORY_OWNER" "$OWNER_HOME/.wordpress-tmp" 2>/dev/null || true

  local ZIP_FILE_NAME="backupdata-$SERVICE_NAME.zip"
  local BACKUP_FILE_PATH="$OWNER_HOME/$ZIP_FILE_NAME"
  local STAGING_DIR="$WP_TMP_DIR/backupdata_staging_$$"

  cleanup_staging() {
    rm -rf "$STAGING_DIR" 2>/dev/null || true
  }
  trap cleanup_staging EXIT

  log_info "Starting backup data for $SERVICE_NAME..."
  mkdir -p "$STAGING_DIR"

  log_info "Dumping MySQL database '$WORDPRESS_DB_NAME'..."
  if ! run_mysql_dump "$WORDPRESS_DB_NAME" > "$STAGING_DIR/dump.sql"; then
    log_error "mysqldump failed."
    exit 1
  fi

  local wp_version
  wp_version=$(extract_wp_version)
  cat <<EOF > "$STAGING_DIR/manifest.json"
{
  "application": "wordpress",
  "service_name": "$SERVICE_NAME",
  "db_name": "$WORDPRESS_DB_NAME",
  "wp_version": "$wp_version",
  "created_at": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF

  local items_to_zip=("$STAGING_DIR/dump.sql" "$STAGING_DIR/manifest.json")

  if [ -d "$PATH_TO_WP/data/wordpress" ]; then
    log_info "Including WordPress files from data/wordpress..."
    ln -s "$PATH_TO_WP/data/wordpress" "$STAGING_DIR/wordpress" 2>/dev/null || cp -al "$PATH_TO_WP/data/wordpress" "$STAGING_DIR/wordpress" 2>/dev/null || cp -r "$PATH_TO_WP/data/wordpress" "$STAGING_DIR/wordpress"
    items_to_zip+=("$STAGING_DIR/wordpress")
  fi

  log_info "Building zip archive $BACKUP_FILE_PATH..."
  rm -f "$BACKUP_FILE_PATH"
  (
    cd "$STAGING_DIR"
    "$zip_cmd" a -tzip -mmt=on "$BACKUP_FILE_PATH" dump.sql manifest.json $([ -e wordpress ] && echo wordpress) >/dev/null
  )

  chmod 644 "$BACKUP_FILE_PATH"
  chown "$REPOSITORY_OWNER":"$REPOSITORY_OWNER" "$BACKUP_FILE_PATH" 2>/dev/null || chown "${SUDO_USER:-$USER}:${SUDO_USER:-$USER}" "$BACKUP_FILE_PATH" 2>/dev/null || true

  log_success "Backup data completed successfully: $BACKUP_FILE_PATH"

  # Optional Secondary VPS sync
  local SNAPSHOT_REMOTE_HOST SNAPSHOT_REMOTE_USER SNAPSHOT_REMOTE_PORT SNAPSHOT_REMOTE_KEY
  SNAPSHOT_REMOTE_HOST=$(grep "^SNAPSHOT_REMOTE_HOST=" "$ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
  if [ -n "$SNAPSHOT_REMOTE_HOST" ]; then
    SNAPSHOT_REMOTE_USER=$(grep "^SNAPSHOT_REMOTE_USER=" "$ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
    SNAPSHOT_REMOTE_PORT=$(grep "^SNAPSHOT_REMOTE_PORT=" "$ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
    SNAPSHOT_REMOTE_KEY=$(grep "^SNAPSHOT_REMOTE_KEY=" "$ENV_FILE" 2>/dev/null | cut -d '=' -f2- | sed 's/[[:space:]]*#.*//' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'\'']//;s/["'\'']$//')
    [ -z "$SNAPSHOT_REMOTE_PORT" ] && SNAPSHOT_REMOTE_PORT="22"

    if [ -n "$SNAPSHOT_REMOTE_USER" ]; then
      local rsync_ssh="ssh -p $SNAPSHOT_REMOTE_PORT -o BatchMode=yes -o StrictHostKeyChecking=accept-new"
      [ -n "$SNAPSHOT_REMOTE_KEY" ] && [ -f "$SNAPSHOT_REMOTE_KEY" ] && rsync_ssh+=" -i $SNAPSHOT_REMOTE_KEY"

      log_info "Transferring $ZIP_FILE_NAME to Secondary VPS ($SNAPSHOT_REMOTE_USER@$SNAPSHOT_REMOTE_HOST)..."
      if rsync -e "$rsync_ssh" -avz "$BACKUP_FILE_PATH" "$SNAPSHOT_REMOTE_USER@$SNAPSHOT_REMOTE_HOST:~/$ZIP_FILE_NAME"; then
        log_success "Backup file successfully transferred to Secondary VPS."
      else
        log_warn "Failed to transfer backup file to Secondary VPS."
      fi
    fi
  fi
}

main "$@"
